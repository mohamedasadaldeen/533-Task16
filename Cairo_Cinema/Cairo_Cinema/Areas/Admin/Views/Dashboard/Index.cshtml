@model DashboardVM

<style>
    .dash-page {
        background-color: rgba(21, 21, 25, 0.6);
        color: #fff;
        padding: 30px 25px;
        margin: 1rem 0;
        border-radius: 12px;
    }

        .dash-page .page-title {
            color: #ffc107;
            font-weight: 700;
            margin: 0 0 4px;
        }

        .dash-page .page-sub {
            color: #a5a5ad;
            margin: 0 0 24px;
        }

        /* ---------- Stat Cards ---------- */
        .dash-page .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 16px;
            margin-bottom: 24px;
        }

        .dash-page .stat-card {
            display: flex;
            align-items: center;
            gap: 16px;
            background-color: #202027;
            border: 1px solid #303038;
            border-radius: 12px;
            padding: 18px 20px;
            transition: 0.3s;
        }

            .dash-page .stat-card:hover {
                border-color: #ffc107;
                transform: translateY(-3px);
            }

        .dash-page .stat-icon {
            flex: 0 0 48px;
            height: 48px;
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: rgba(255, 193, 7, 0.12);
            color: #ffc107;
            font-size: 20px;
            border-radius: 12px;
        }

        .dash-page .stat-value {
            font-size: 26px;
            font-weight: 700;
            line-height: 1;
            margin: 0 0 4px;
        }

        .dash-page .stat-label {
            color: #a5a5ad;
            font-size: 14px;
            margin: 0;
        }

        /* ---------- Chart Cards ---------- */
        .dash-page .charts-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 16px;
        }

        .dash-page .chart-card {
            background-color: #202027;
            border: 1px solid #303038;
            border-radius: 12px;
            padding: 20px;
        }

            .dash-page .chart-card.wide {
                grid-column: 1 / -1;
            }

        .dash-page .chart-title {
            color: #ffc107;
            font-size: 16px;
            font-weight: 700;
            margin: 0 0 16px;
        }

        .dash-page .chart-box {
            position: relative;
            height: 300px;
        }

    @@media (max-width: 992px) {
        .dash-page .charts-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="container-fluid">
    <div class="dash-page">

        <h3 class="page-title">Dashboard</h3>
        <p class="page-sub">Overview of Cairo Cinema</p>

        <!-- Stat Cards -->
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-icon"><i class="fas fa-film"></i></div>
                <div>
                    <p class="stat-value">@Model.MoviesCount</p>
                    <p class="stat-label">Movies</p>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon"><i class="fas fa-layer-group"></i></div>
                <div>
                    <p class="stat-value">@Model.CategoriesCount</p>
                    <p class="stat-label">Categories</p>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon"><i class="fas fa-building"></i></div>
                <div>
                    <p class="stat-value">@Model.CinemasCount</p>
                    <p class="stat-label">Cinemas</p>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon"><i class="fas fa-star"></i></div>
                <div>
                    <p class="stat-value">@Model.ActorsCount</p>
                    <p class="stat-label">Actors</p>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon"><i class="fas fa-users"></i></div>
                <div>
                    <p class="stat-value">@Model.UsersCount</p>
                    <p class="stat-label">Users</p>
                </div>
            </div>
        </div>

        <!-- Charts -->
        <div class="charts-grid">
            <div class="chart-card wide">
                <h5 class="chart-title">Overview</h5>
                <div class="chart-box"><canvas id="overviewChart"></canvas></div>
            </div>

            <div class="chart-card">
                <h5 class="chart-title">Movies per Category</h5>
                <div class="chart-box"><canvas id="categoryChart"></canvas></div>
            </div>

            <div class="chart-card">
                <h5 class="chart-title">Movies per Cinema</h5>
                <div class="chart-box"><canvas id="cinemaChart"></canvas></div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        Chart.defaults.color = '#a5a5ad';
        Chart.defaults.borderColor = '#303038';
        Chart.defaults.font.family = 'inherit';

        const palette = ['#ffc107', '#ff9800', '#ffd54f', '#ffb300', '#f57c00', '#ffe082', '#ff6f00', '#fff3c4'];

        const categories = @Html.Raw(Json.Serialize(Model.MoviesPerCategory));
        const cinemas = @Html.Raw(Json.Serialize(Model.MoviesPerCinema));

        // ---------- Overview (Bar) ----------
        new Chart(document.getElementById('overviewChart'), {
            type: 'bar',
            data: {
                labels: ['Movies', 'Categories', 'Cinemas', 'Actors', 'Users'],
                datasets: [{
                    data: [@Model.MoviesCount, @Model.CategoriesCount, @Model.CinemasCount, @Model.ActorsCount, @Model.UsersCount],
                    backgroundColor: palette,
                    borderRadius: 8,
                    maxBarThickness: 60
                }]
            },
            options: {
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
            }
        });

        // ---------- Movies per Category (Doughnut) ----------
        new Chart(document.getElementById('categoryChart'), {
            type: 'doughnut',
            data: {
                labels: categories.map(x => x.label),
                datasets: [{
                    data: categories.map(x => x.value),
                    backgroundColor: palette,
                    borderColor: '#202027',
                    borderWidth: 3
                }]
            },
            options: {
                maintainAspectRatio: false,
                cutout: '65%',
                plugins: { legend: { position: 'bottom' } }
            }
        });

        // ---------- Movies per Cinema (Horizontal Bar) ----------
        new Chart(document.getElementById('cinemaChart'), {
            type: 'bar',
            data: {
                labels: cinemas.map(x => x.label),
                datasets: [{
                    data: cinemas.map(x => x.value),
                    backgroundColor: '#ffc107',
                    borderRadius: 6,
                    maxBarThickness: 28
                }]
            },
            options: {
                indexAxis: 'y',
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: { x: { beginAtZero: true, ticks: { precision: 0 } } }
            }
        });
    </script>
}