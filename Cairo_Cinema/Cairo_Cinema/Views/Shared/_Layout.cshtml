@* _________________________ *@
@* كود عددد العناصر فالسلة *@
@using System.Security.Claims
@using Cairo_Cinema.Data
@inject ApplicationDbContext Db

@{
    var userId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var cartCount = Db.Carts.Count(c => c.ApplicationUserId == userId);
}
@* _________________________ *@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Cairo_Cinema</title>

    <script type="importmap"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/customer/css/site.css" asp-append-version="true" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />

    <script src="https://use.fontawesome.com/releases/v6.3.0/js/all.js" crossorigin="anonymous"></script>
</head>

<body>

    <header class="cinema-header">

        <nav class="navbar navbar-expand-lg cinema-navbar">

            <div class="container">

                <!-- Logo -->
                <a class="navbar-brand cinema-logo d-flex align-items-center">
                   
                    <svg xmlns="http://www.w3.org/2000/svg"
                         width="38"
                         height="38"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="#ffc107"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round"
                         class="cinema-logo-icon">

                        <rect x="3" y="7" width="18" height="14" rx="2" />
                        <path d="M7 7 10 3" />
                        <path d="M14 7 17 3" />
                        <path d="M10 12 15 14.5 10 17Z"
                              fill="#ffc107"
                              stroke="#ffc107" />
                    </svg>

                    <span class="cinema-brand-text">
                        Cairo <span class="cinema-brand-highlight">Cinema</span>
                    </span>

                </a>

                <!-- Mobile Toggle -->
                <button class="navbar-toggler cinema-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#cinemaNavbar"
                        aria-controls="cinemaNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <!-- Navbar Content -->
                <div class="collapse navbar-collapse" id="cinemaNavbar">

                   

                    <div class="cinema-navbar-content">
                        <!-- Shopping Cart -->
                        @if (User.Identity.IsAuthenticated)
                            {
                            <a class="cinema-cart-btn"
                               href="~/Customer/Cart/Index"
                               aria-label="Shopping Cart">
                                <i class="bi bi-cart3"></i>
                                <span class="cart-badge">@cartCount</span>
                            </a>
                            }
                            <!-- Menu -->
                        <div class="dropdown cinema-menu-wrapper">

                            <button class="btn cinema-menu-btn"
                                    type="button"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false"
                                    aria-label="Open Menu">

                                <i class="bi bi-list"></i>

                            </button>

                            <ul class="dropdown-menu dropdown-menu-end cinema-dropdown">

                                <!-- Pages -->
                                <li class="cinema-dropdown-heading">
                                    <span></span>
                                    <small>PAGES</small>
                                    <span></span>
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                       asp-area="Customer"
                                       asp-controller="Home"
                                       asp-action="Index">
                                        <i class="bi bi-house-door"></i>
                                        Home
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                       >
                                        <i class="bi bi-film"></i>
                                        Movies
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item" href="#">
                                        <i class="bi bi-grid"></i>
                                        Categories
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item" href="#">
                                        <i class="bi bi-building"></i>
                                        Cinemas
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item" href="#">
                                        <i class="bi bi-people"></i>
                                        Actors
                                    </a>
                                </li>

                                <!-- Account -->
                                <li class="cinema-dropdown-heading cinema-account-heading">
                                    <span></span>
                                    <small>ACCOUNT</small>
                                    <span></span>
                                </li>
                                @if (!User.Identity.IsAuthenticated)
                                    {
                                        <li>
                                            <a class="dropdown-item"
                                            asp-area="Identity"
                                            asp-controller="Account"
                                            asp-action="Login">

                                                <i class="bi bi-box-arrow-in-right"></i>
                                                Login

                                            </a>
                                        </li>

                                        <li>
                                            <a class="dropdown-item"
                                            asp-area="Identity"
                                            asp-controller="Account"
                                            asp-action="Register">

                                                <i class="bi bi-person-plus"></i>
                                                Register

                                            </a>
                                        </li>

                                    }
                                    else
                                    {
                   

                                    <li>
                                        <a class="dropdown-item cinema-logout-item"
                                           asp-area="Identity"
                                           asp-controller="Account"
                                           asp-action="Logout">

                                            <i class="bi bi-box-arrow-right"></i>
                                            Logout

                                        </a>
                                    </li>
                                    }

                                    @if (User.Identity.IsAuthenticated)
                                    {
                                    <li>
                                        <a class="dropdown-item"
                                           asp-area="Identity"
                                           asp-controller="Profile"
                                           asp-action="Index">
                                            <i class="bi bi-person-circle"></i>
                                            @User.Identity.Name

                                        </a>
                                    </li>
                                    }
                                </ul>

                        </div>

                    </div>

                </div>

            </div>

        </nav>

    </header>

    <div class="container">

        <main role="main" class="pb-3">
            @RenderBody()
        </main>

    </div>

    <!-- Footer -->
    <footer class="cinema-footer">

        <div class="container">

            <div class="footer-content">

                 
                <a class="footer-logo">

                    Cairo <span>Cinema</span>

                </a>

                <div class="footer-links">
                    <a href="#">Home</a>
                    <a href="#">Movies</a>
                    <a href="#">Categories</a>
                    <a href="#">Actors</a>
                </div>

            </div>

            <div class="footer-bottom">

                <p>
                    © @DateTime.Now.Year Cairo Cinema. All rights reserved.
                </p>

                <div class="footer-social">

                    <a href="https://www.facebook.com/" aria-label="Facebook">
                        <i class="bi bi-facebook"></i>
                    </a>

                    <a href="https://www.instagram.com/" aria-label="Instagram">
                        <i class="bi bi-instagram"></i>
                    </a>

                    <a href="https://www.youtube.com/" aria-label="YouTube">
                        <i class="bi bi-youtube"></i>
                    </a>

                </div>

            </div>

        </div>

    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- Toastr -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
