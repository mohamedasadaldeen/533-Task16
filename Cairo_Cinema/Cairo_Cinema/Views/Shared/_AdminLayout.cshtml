
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Cairo_Cinema</title>

    <script type="importmap"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Cairo_Cinema.styles.css" asp-append-version="true" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/simple-datatables@7.1.2/dist/style.min.css" />

    <link rel="stylesheet" href="~/admin/css/styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/admin/css/cairo-dashboard.css" asp-append-version="true" />

    @* toastr *@
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />

    <script src="https://use.fontawesome.com/releases/v6.3.0/js/all.js"
            crossorigin="anonymous"></script>
</head>

<body>

    <!-- Main Layout -->
    <div id="layoutSidenav">

        <!-- Sidebar - Unchanged -->
        <div id="layoutSidenav_nav">

            <nav class="sb-sidenav accordion sb-sidenav-dark"
                 id="sidenavAccordion">

                <div class="sb-sidenav-menu">

                    <div class="nav">

               

                        <div class="sb-sidenav-menu-heading">Core</div>

                        <a class="nav-link"
                           asp-area="Admin"
                           asp-controller="Dashboard"
                           asp-action="Index">

                            <div class="sb-nav-link-icon">
                                <i class="fas fa-tachometer-alt"></i>
                            </div>

                            Dashboard
                        </a>

                        <div class="sb-sidenav-menu-heading">Interface</div>

                        <!-- Layouts Dropdown -->
                        <a class="nav-link collapsed"
                           href="#collapseLayouts"
                           data-bs-toggle="collapse"
                           data-bs-target="#collapseLayouts"
                           aria-expanded="false"
                           aria-controls="collapseLayouts">

                            <div class="sb-nav-link-icon">
                                <i class="fa-solid fa-users"></i>
                            </div>

                            Users

                            <div class="sb-sidenav-collapse-arrow">
                                <i class="fas fa-angle-down"></i>
                            </div>
                        </a>

                        <div class="collapse"
                             id="collapseLayouts"
                             data-bs-parent="#sidenavAccordion">

                            <div class="sb-sidenav-menu-heading">Users</div>

                            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Create" && ViewContext.RouteData.Values["controller"]?.ToString() == "Profile" ? "active" : "")"
                               asp-area="Admin"
                               asp-controller="User"
                               asp-action="Create">
                            
                                <div class="sb-nav-link-icon">
                                    <i class="fas fa-user-plus"></i>
                                </div>
                            
                                Add User
                            </a>

                            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Create" && ViewContext.RouteData.Values["controller"]?.ToString() == "Profile" ? "active" : "")"
                               asp-area="Admin"
                               asp-controller="User"
                               asp-action="Index">
                            
                                <div class="sb-nav-link-icon">
                                    <i class="fa-solid fa-list"></i>
                                </div>
                            
                                View Users
                            </a>

                        </div>

                        <!-- Pages Dropdown -->
                        <a class="nav-link collapsed"
                           href="#collapsePages"
                           data-bs-toggle="collapse"
                           data-bs-target="#collapsePages"
                           aria-expanded="false"
                           aria-controls="collapsePages">

                            <div class="sb-nav-link-icon">
                                <i class="fas fa-book-open"></i>
                            </div>

                            Pages

                            <div class="sb-sidenav-collapse-arrow">
                                <i class="fas fa-angle-down"></i>
                            </div>
                        </a>

                        <div class="collapse"
                             id="collapsePages"
                             data-bs-parent="#sidenavAccordion">

                            <nav class="sb-sidenav-menu-nested nav"
                                 id="sidenavAccordionPages">

                                <!-- Authentication -->
                                <a class="nav-link collapsed"
                                   href="#pagesCollapseAuth"
                                   data-bs-toggle="collapse"
                                   data-bs-target="#pagesCollapseAuth"
                                   aria-expanded="false"
                                   aria-controls="pagesCollapseAuth">

                                    Authentication

                                    <div class="sb-sidenav-collapse-arrow">
                                        <i class="fas fa-angle-down"></i>
                                    </div>
                                </a>

                                <div class="collapse" id="pagesCollapseAuth">

                                    <nav class="sb-sidenav-menu-nested nav">

                                        <a class="nav-link" href="#">Login</a>
                                        <a class="nav-link" href="#">Register</a>
                                        <a class="nav-link" href="#">Forgot Password</a>

                                    </nav>
                                </div>

                                <!-- Error Pages -->
                                <a class="nav-link collapsed"
                                   href="#pagesCollapseError"
                                   data-bs-toggle="collapse"
                                   data-bs-target="#pagesCollapseError"
                                   aria-expanded="false"
                                   aria-controls="pagesCollapseError">

                                    Error

                                    <div class="sb-sidenav-collapse-arrow">
                                        <i class="fas fa-angle-down"></i>
                                    </div>
                                </a>

                                <div class="collapse" id="pagesCollapseError">

                                    <nav class="sb-sidenav-menu-nested nav">

                                        <a class="nav-link" href="#">401 Page</a>
                                        <a class="nav-link" href="#">404 Page</a>
                                        <a class="nav-link" href="#">500 Page</a>

                                    </nav>
                                </div>

                            </nav>
                        </div>

                        <!-- Addons -->
                        <div class="sb-sidenav-menu-heading">Addons</div>

                        <a class="nav-link" href="#">
                            <div class="sb-nav-link-icon">
                                <i class="fas fa-chart-area"></i>
                            </div>
                            Charts
                        </a>

                        <a class="nav-link" href="#">
                            <div class="sb-nav-link-icon">
                                <i class="fas fa-table"></i>
                            </div>
                            Tables
                        </a>

                    </div>
                </div>

               @*  <!-- Sidebar Footer -->
                <div class="sb-sidenav-footer">
                    <div class="small">Logged in as:</div>
                    Cairo Cinema Dashboard
                </div> *@

            </nav>
        </div>

        <!-- Page Content -->
        <div id="layoutSidenav_content">

            <!-- Cinema Header -->
            <header class="cinema-header">

                <nav class="navbar navbar-expand-lg cinema-navbar">

                    <div class="container">
                        <!-- Sidebar Toggle -->
                        <button class="admin-sidebar-toggle"
                                id="sidebarToggle"
                                type="button"
                                aria-label="Toggle Sidebar"
                                title="Show / Hide Sidebar">
                        
                            <i class="bi bi-layout-sidebar-inset"></i>
                        
                        </button>

                        <!-- Logo -->
                        <a class="navbar-brand cinema-logo d-flex align-items-center">
                           

                            <svg xmlns="http://www.w3.org/2000/svg"
                                 width="38"
                                 height="38"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="#ffc107"
                                 stroke-width="1.8"
                                 stroke-linecap="round"
                                 stroke-linejoin="round"
                                 class="cinema-logo-icon">

                                <rect x="3" y="7" width="18" height="14" rx="2" />
                                <path d="M7 7 10 3" />
                                <path d="M14 7 17 3" />
                                <path d="M10 12 15 14.5 10 17Z"
                                      fill="#ffc107"
                                      stroke="#ffc107" />
                            </svg>

                            <span class="cinema-brand-text">
                                Cairo <span class="cinema-brand-highlight">Cinema</span>
                            </span>

                        </a>

                        <!-- Mobile Toggle -->
                        <button class="navbar-toggler cinema-toggler"
                                type="button"
                                data-bs-toggle="collapse"
                                data-bs-target="#cinemaNavbar"
                                aria-controls="cinemaNavbar"
                                aria-expanded="false"
                                aria-label="Toggle navigation">

                            <span class="navbar-toggler-icon"></span>

                        </button>

                        <!-- Navbar Content -->
                        <div class="collapse navbar-collapse" id="cinemaNavbar">

                            <div class="cinema-navbar-content">

                                <!-- Menu -->
                                <div class="dropdown cinema-menu-wrapper">

                                    <button class="btn cinema-menu-btn"
                                            type="button"
                                            data-bs-toggle="dropdown"
                                            aria-expanded="false"
                                            aria-label="Open Menu">

                                        <i class="bi bi-list"></i>

                                    </button>

                                    <ul class="dropdown-menu dropdown-menu-end cinema-dropdown">

                                        <li class="cinema-dropdown-heading">
                                            <span></span>
                                            <small>PAGES</small>
                                            <span></span>
                                        </li>

                                        <li>
                                            <a class="dropdown-item"
                                               asp-area="Admin"
                                               asp-controller="Movie"
                                               asp-action="Index">
                                                <i class="bi bi-film"></i>
                                                Movies
                                            </a>
                                        </li>

                                        <li>
                                            <a class="dropdown-item" 
                                                asp-area="Admin"
                                                asp-controller="Category"
                                                asp-action="Index">
                                                <i class="bi bi-grid"></i>
                                                Categories
                                            </a>
                                        </li>

                                        <li>
                                            <a class="dropdown-item"
                                                asp-area="Admin"
                                                asp-controller="Cinema"
                                                asp-action="Index">
                                                <i class="bi bi-building"></i>
                                                Cinemas
                                            </a>
                                        </li>

                                        <li>
                                            <a class="dropdown-item" 
                                                asp-area="Admin"
                                                asp-controller="Actor"
                                                asp-action="Index">
                                                <i class="bi bi-people"></i>
                                                Actors
                                            </a>
                                        </li>

                                        <li class="cinema-dropdown-heading cinema-account-heading">
                                            <span></span>
                                            <small>ACCOUNT</small>
                                            <span></span>
                                        </li>
                                        @if (!User.Identity.IsAuthenticated)
                                            {
                                                    
                                                
                                                <li>
                                                <a class="dropdown-item"
                                                   asp-area="Identity"
                                                   asp-controller="Account"
                                                   asp-action="Login">

                                                    <i class="bi bi-box-arrow-in-right"></i>
                                                    Login

                                                </a>
                                            </li>

                                            <li>
                                                <a class="dropdown-item"
                                                   asp-area="Identity"
                                                   asp-controller="Account"
                                                   asp-action="Register">
                                            
                                                    <i class="bi bi-person-plus"></i>
                                                    Register
                                            
                                                </a>
                                            </li>
                                            }

                                            else
                                            {

                                                <li>
                                                    <a class="dropdown-item cinema-logout-item"
                                                       asp-area="Identity"
                                                       asp-controller="Account"
                                                       asp-action="Logout">
                                                
                                                        <i class="bi bi-box-arrow-right"></i>
                                                        Logout
                                                
                                                    </a>
                                                </li>
                                            }
                                    @if (User.Identity.IsAuthenticated)
                                    {
                                    <li>
                                        <a class="dropdown-item"
                                           asp-area="Identity"
                                           asp-controller="Profile"
                                           asp-action="Index">
                                            <i class="bi bi-person-circle"></i>
                                            @User.Identity.Name

                                        </a>
                                    </li>
                                    }
                                    </ul>

                                </div>

                            </div>

                        </div>

                    </div>

                </nav>

            </header>

            <main role="main" class="dashboard-page-content">
                @RenderBody()
            </main>

            <!-- Footer - Unchanged -->
            <footer class="py-4 bg-light mt-auto">

                <div class="container-fluid px-4">

                    <div class="d-flex align-items-center justify-content-between small">

                        <div class="text-muted">
                            Copyright &copy; Cairo Cinema 2026
                        </div>

                        <div>
                            <a href="#">Privacy Policy</a>
                            &middot;
                            <a href="#">Terms &amp; Conditions</a>
                        </div>

                    </div>
                </div>
            </footer>

        </div>
    </div>

    <!-- JavaScript -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/admin/js/scripts.js" asp-append-version="true"></script>

    <script src="https://cdn.jsdelivr.net/npm/simple-datatables@7.1.2/dist/umd/simple-datatables.min.js"
            crossorigin="anonymous"></script>

    <script src="~/admin/js/datatables-simple-demo.js"
            asp-append-version="true"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- Toastr -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
